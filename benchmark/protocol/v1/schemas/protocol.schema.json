{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/frontend-design-ultra/benchmark/protocol.schema.json",
  "title": "Frontend Design Ultra Benchmark Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "benchmarkVersion",
    "evidenceTier",
    "status",
    "resultsStatus",
    "createdDate",
    "objective",
    "scope",
    "conditionIds",
    "tracks",
    "budgets",
    "primaryEndpoint",
    "creativeDimensions",
    "shippingGates",
    "jury",
    "randomization",
    "holdout",
    "publication"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "benchmarkVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "evidenceTier": { "enum": ["calibration", "scored"] },
    "status": { "enum": ["pending", "frozen", "running", "complete"] },
    "resultsStatus": { "enum": ["pending", "partial", "complete"] },
    "createdDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "objective": { "type": "string", "minLength": 40 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibrationBriefs", "scoredBriefTarget", "publicScoredBriefTarget", "sealedHoldoutTarget", "replicatesPerCondition"],
      "properties": {
        "calibrationBriefs": { "type": "integer", "minimum": 1 },
        "scoredBriefTarget": { "type": "integer", "minimum": 1 },
        "publicScoredBriefTarget": { "type": "integer", "minimum": 0 },
        "sealedHoldoutTarget": { "type": "integer", "minimum": 1 },
        "replicatesPerCondition": { "type": "integer", "minimum": 2 }
      }
    },
    "conditionIds": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "networkDuringRun", "imageGenerationCalls", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "status": { "enum": ["pending", "active", "deferred", "complete"] },
          "networkDuringRun": { "type": "boolean" },
          "imageGenerationCalls": { "type": "integer", "minimum": 0 },
          "description": { "type": "string", "minLength": 20 }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumWallClockMinutes", "maximumTotalTokens", "maximumToolCalls", "maximumRepairLoops", "maximumGenerationAttempts", "maximumCaptureAttemptsPerGeneration", "humanCodeEdits"],
      "properties": {
        "maximumWallClockMinutes": { "type": "integer", "minimum": 1 },
        "maximumTotalTokens": { "type": "integer", "minimum": 1 },
        "maximumToolCalls": { "type": "integer", "minimum": 1 },
        "maximumRepairLoops": { "type": "integer", "minimum": 0 },
        "maximumGenerationAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "maximumCaptureAttemptsPerGeneration": { "type": "integer", "minimum": 1, "maximum": 5 },
        "humanCodeEdits": { "const": 0 }
      }
    },
    "primaryEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "tieValue", "confidenceInterval"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 20 },
        "tieValue": { "const": 0.5 },
        "confidenceInterval": { "type": "string", "minLength": 1 }
      }
    },
    "creativeDimensions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "weight"],
        "properties": {
          "id": { "enum": ["design", "usability", "creativity", "content"] },
          "weight": { "type": "number", "minimum": 0 }
        }
      }
    },
    "shippingGates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "jury": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumIndependentJurors",
        "minimumValidVotesPerComparison",
        "minimumIndependentPanelShare",
        "identifierMode",
        "consentRequired",
        "consentRecords",
        "privateIdentityMapRetentionDays",
        "privateConsentRecordRetentionDays",
        "publicVoteData",
        "freeTextRedactionRequired",
        "invalidVotePolicy"
      ],
      "properties": {
        "minimumIndependentJurors": { "type": "integer", "minimum": 3 },
        "minimumValidVotesPerComparison": { "type": "integer", "minimum": 2 },
        "minimumIndependentPanelShare": { "type": "number", "minimum": 0.5, "maximum": 1 },
        "identifierMode": { "const": "pseudonymous" },
        "consentRequired": { "const": true },
        "consentRecords": { "const": "private-not-published" },
        "privateIdentityMapRetentionDays": { "type": "integer", "minimum": 1 },
        "privateConsentRecordRetentionDays": { "type": "integer", "minimum": 1 },
        "publicVoteData": { "const": "pseudonymous-redacted" },
        "freeTextRedactionRequired": { "const": true },
        "invalidVotePolicy": { "const": "reason-required-no-dimension-scores" }
      }
    },
    "randomization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditionLabelsHidden", "leftRightRandomized", "assignmentOrderRandomized", "mappingRevealedAfterVoteFreeze"],
      "properties": {
        "conditionLabelsHidden": { "const": true },
        "leftRightRandomized": { "const": true },
        "assignmentOrderRandomized": { "const": true },
        "mappingRevealedAfterVoteFreeze": { "const": true }
      }
    },
    "holdout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "commitmentAlgorithm", "revealAfterVoteFreeze"],
      "properties": {
        "status": { "enum": ["pending", "committed", "revealed"] },
        "commitmentAlgorithm": { "const": "sha256-salted-freeze-bound-canonical-manifest-v3" },
        "revealAfterVoteFreeze": { "const": true }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publishFailedRuns", "publishPseudonymousRedactedVotes", "publishExactConditionPins", "publishKnownLimitations", "largeArtifactsByDigest", "publishRightsReview"],
      "properties": {
        "publishFailedRuns": { "const": true },
        "publishPseudonymousRedactedVotes": { "const": true },
        "publishExactConditionPins": { "const": true },
        "publishKnownLimitations": { "const": true },
        "largeArtifactsByDigest": { "const": true },
        "publishRightsReview": { "const": true }
      }
    }
  }
}
