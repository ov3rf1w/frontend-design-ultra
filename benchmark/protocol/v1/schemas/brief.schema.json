{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/frontend-design-ultra/benchmark/brief.schema.json",
  "title": "Benchmark Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "split", "fictional", "title", "industry", "projectType", "locale", "audience", "pageJob", "targetAction", "facts", "requiredContent", "constraints", "assetPolicy", "shippingBudgets"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^cal-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "split": { "const": "calibration" },
    "fictional": { "const": true },
    "title": { "type": "string", "minLength": 3 },
    "industry": { "type": "string", "minLength": 3 },
    "projectType": { "enum": ["greenfield", "constrained-brand", "redesign"] },
    "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "audience": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "pageJob": { "type": "string", "minLength": 20 },
    "targetAction": { "type": "string", "minLength": 5 },
    "facts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "publicClaimAllowed"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "statement": { "type": "string", "minLength": 5 },
          "publicClaimAllowed": { "type": "boolean" }
        }
      }
    },
    "requiredContent": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 3 } },
    "constraints": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 3 } },
    "assetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remoteAssets", "generatedMedia", "suppliedAssetCount", "instruction"],
      "properties": {
        "remoteAssets": { "const": false },
        "generatedMedia": { "const": false },
        "suppliedAssetCount": { "const": 0 },
        "instruction": { "type": "string", "minLength": 20 }
      }
    },
    "shippingBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumInitialJavaScriptKbGzip", "maximumImageBytes", "minimumTapTargetPx", "accessibilityTarget"],
      "properties": {
        "maximumInitialJavaScriptKbGzip": { "type": "integer", "minimum": 1 },
        "maximumImageBytes": { "const": 0 },
        "minimumTapTargetPx": { "type": "integer", "minimum": 24 },
        "accessibilityTarget": { "const": "WCAG 2.2 AA practical floor; conformance requires complete evidence" }
      }
    }
  }
}

