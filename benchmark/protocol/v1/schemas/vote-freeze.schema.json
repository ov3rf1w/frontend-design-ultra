{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/frontend-design-ultra/benchmark/vote-freeze.schema.json",
  "title": "Benchmark Jury Vote Freeze",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "benchmarkVersion", "status", "frozenAt", "packet", "evidence", "votes"],
  "properties": {
    "$schema": { "const": "../../protocol/v1/schemas/vote-freeze.schema.json" },
    "schemaVersion": { "const": 1 },
    "benchmarkVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "status": { "const": "frozen" },
    "frozenAt": { "type": "string", "format": "date-time" },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "jury-packet.json" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "count", "files", "setSha256"],
      "properties": {
        "root": { "const": "jury-evidence" },
        "count": { "type": "integer", "minimum": 12 },
        "files": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^entries/E-[A-Z2-7]+/A-[A-Z2-7]+\\.[a-z0-9]+$" },
              "bytes": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "setSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "votes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "validCount", "invalidCount", "files", "setSha256"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "validCount": { "type": "integer", "minimum": 0 },
        "invalidCount": { "type": "integer", "minimum": 0 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^jury-votes/P-[A-Z2-7]+--J-[A-Z2-7]+\\.json$" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "setSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
