{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/frontend-design-ultra/benchmark/jury-mapping-reveal.schema.json",
  "title": "Benchmark Jury Mapping Reveal",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "benchmarkVersion", "status", "revealedAt", "packetSha256", "voteFreezeSha256", "keyHex", "keySha256"],
  "properties": {
    "$schema": { "const": "../../protocol/v1/schemas/jury-mapping-reveal.schema.json" },
    "schemaVersion": { "const": 1 },
    "benchmarkVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "status": { "const": "revealed" },
    "revealedAt": { "type": "string", "format": "date-time" },
    "packetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "voteFreezeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "keyHex": { "type": "string", "pattern": "^(?:[a-f0-9]{2}){32,}$" },
    "keySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
