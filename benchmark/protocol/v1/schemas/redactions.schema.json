{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/frontend-design-ultra/benchmark/redactions.schema.json",
  "title": "Benchmark Publication Redactions",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "benchmarkVersion", "items"],
  "properties": {
    "$schema": { "const": "../../protocol/v1/schemas/redactions.schema.json" },
    "schemaVersion": { "const": 1 },
    "benchmarkVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["redactionId", "targetRole", "action", "reasonCode", "publishedPath", "publishedSha256", "protectedFieldsBeforeSha256", "protectedFieldsAfterSha256", "affectsScoring"],
        "properties": {
          "redactionId": { "type": "string", "pattern": "^RED-[0-9]{3,}$" },
          "targetRole": { "const": "jury-vote-free-text" },
          "action": { "const": "remove-direct-identifier" },
          "reasonCode": { "enum": ["email", "phone", "url", "name-or-handle", "other-direct-identifier"] },
          "publishedPath": { "type": "string", "pattern": "^jury-votes/P-[A-Z2-7]+--J-[A-Z2-7]+\\.json$" },
          "publishedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "protectedFieldsBeforeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "protectedFieldsAfterSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "affectsScoring": { "const": false }
        }
      }
    }
  }
}
